{
  "name": "ComplianceSettings",
  "type": "object",
  "properties": {
    "enforce_medical_blocking": {
      "type": "boolean",
      "title": "\u05d7\u05e1\u05d5\u05dd \u05e9\u05d7\u05e7\u05e0\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d1\u05ea\u05d5\u05e7\u05e3 \u05de\u05d4\u05e1\u05d2\u05dc \u05d4\u05e4\u05e2\u05d9\u05dc",
      "default": false
    },
    "report_email": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d9\u05d9\u05dc \u05dc\u05d3\u05d5\u05d7 \u05e9\u05d1\u05d5\u05e2\u05d9"
    },
    "retention_enabled": {
      "type": "boolean",
      "title": "\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05de\u05d7\u05d9\u05e7\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05de\u05d5\u05e4\u05e2\u05dc\u05ea (Retention Policy)",
      "default": false,
      "description": "\u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e4\u05e2\u05dc\u05d4/\u05db\u05d9\u05d1\u05d5\u05d9 \u05e9\u05dc \u05e1\u05e8\u05d9\u05e7\u05ea \u05de\u05d7\u05d9\u05e7\u05d4/\u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05e9\u05dc \u05e0\u05ea\u05d5\u05e0\u05d9 \u05e7\u05d8\u05d9\u05e0\u05d9\u05dd \u05dc\u05d0-\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd \u05d1\u05d4\u05ea\u05d0\u05dd \u05dc\u05ea\u05e7\u05e0\u05d5\u05df \u05d4\u05d4\u05ea\u05d0\u05d7\u05d3\u05d5\u05ea."
    },
    "retention_minor_days_after_inactivity": {
      "type": "number",
      "title": "\u05d9\u05de\u05d9 \u05d7\u05d5\u05e1\u05e8-\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e2\u05d3 \u05de\u05d7\u05d9\u05e7\u05d4/\u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4",
      "default": 2555,
      "description": "\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc 2555 \u05d9\u05de\u05d9\u05dd (\u05db-7 \u05e9\u05e0\u05d9\u05dd). \u05de\u05d3\u05d9\u05d3\u05ea \u05d7\u05d5\u05e1\u05e8-\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05de\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d7\u05d5\u05d6\u05d4 / \u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df."
    },
    "retention_anonymize_only": {
      "type": "boolean",
      "title": "\u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d1\u05dc\u05d1\u05d3 (\u05dc\u05dc\u05d0 \u05de\u05d7\u05d9\u05e7\u05d4 \u05e7\u05e9\u05d4)",
      "default": true,
      "description": "true = \u05de\u05d0\u05e4\u05e1 \u05e9\u05d3\u05d5\u05ea PII \u05d5\u05de\u05e9\u05d0\u05d9\u05e8 \u05e8\u05e9\u05d5\u05de\u05ea-\u05e9\u05dc\u05d3 \u05dc\u05e6\u05d5\u05e8\u05da \u05d7\u05d5\u05d1\u05ea \u05e9\u05de\u05d9\u05e8\u05d4 \u05d7\u05d5\u05e7\u05d9\u05ea. false = \u05de\u05d7\u05d9\u05e7\u05d4 \u05e7\u05e9\u05d4 \u05e9\u05dc \u05d4\u05e8\u05e9\u05d5\u05de\u05d4."
    },
    "retention_last_sweep_at": {
      "type": "string",
      "title": "\u05e1\u05e8\u05d9\u05e7\u05ea \u05de\u05d7\u05d9\u05e7\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d1"
    },
    "retention_last_sweep_count": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e9\u05e2\u05d5\u05d1\u05d3\u05d5 \u05d1\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4",
      "default": 0
    },
    "encryption_at_rest_verified": {
      "type": "boolean",
      "title": "\u05d0\u05d9\u05de\u05d5\u05ea \u05d4\u05e6\u05e4\u05e0\u05d4 \u05d1\u05de\u05e0\u05d5\u05d7\u05d4 (Encryption at Rest) \u05d0\u05d5\u05de\u05ea",
      "default": false,
      "description": "\u05de\u05e1\u05de\u05df \u05e9\u05de\u05e0\u05d4\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d0\u05d9\u05de\u05ea \u05e9\u05d4\u05d0\u05d7\u05e1\u05d5\u05df \u05de\u05d5\u05e6\u05e4\u05df \u05d1-AES-256 (\u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc \u05e9\u05dc \u05d0\u05d7\u05e1\u05d5\u05df Base44 \u05d4\u05e4\u05e8\u05d8\u05d9)."
    },
    "encryption_provider_label": {
      "type": "string",
      "title": "\u05e1\u05e4\u05e7 \u05d0\u05d7\u05e1\u05d5\u05df / \u05d4\u05e6\u05e4\u05e0\u05d4",
      "default": "Base44 Private Storage \u2014 AES-256"
    },
    "encryption_last_verified_at": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d5\u05ea \u05d4\u05e6\u05e4\u05e0\u05d4 \u05d0\u05d7\u05e8\u05d5\u05df \u05d1\u05d5\u05e6\u05e2 \u05d1"
    }
  },
  "required": []
}