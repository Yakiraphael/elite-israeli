{
  "name": "BehaviorLog",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05d9\u05de\u05d5\u05df/\u05e1\u05d3\u05e0\u05d4 (TeamEvent.id)"
    },
    "session_label": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d0\u05d9\u05de\u05d5\u05df (\u05de\u05ea\u05d9\u05d9\u05d7\u05e1)"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d0\u05d9\u05de\u05d5\u05df (\u05de\u05ea\u05d9\u05d9\u05d7\u05e1)"
    },
    "region": {
      "type": "string",
      "title": "\u05d0\u05d6\u05d5\u05e8",
      "enum": [
        "\u05e0\u05ea\u05d9\u05d1\u05d5\u05ea",
        "\u05e7\u05e8\u05d9\u05d9\u05ea \u05d2\u05ea",
        "\u05d1\u05d0\u05e8 \u05e9\u05d1\u05e2",
        "\u05d0\u05d7\u05e8"
      ]
    },
    "player_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d7\u05e7\u05df (PlayerRegistration.id)"
    },
    "player_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e9\u05d7\u05e7\u05df"
    },
    "attended": {
      "type": "boolean",
      "title": "\u05e0\u05db\u05d7 \u05d1\u05d0\u05d9\u05de\u05d5\u05df",
      "default": true
    },
    "discipline_score": {
      "type": "number",
      "title": "\u05e6\u05d9\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05ea (1-10)",
      "default": 7,
      "description": "1 = \u05e0\u05de\u05d5\u05da \u05de\u05d0\u05d5\u05d3, 10 = \u05de\u05e6\u05d8\u05d9\u05d9\u05df. \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05de\u05de\u05d5\u05e6\u05e2 \u05d4\u05de\u05e9\u05de\u05e2\u05ea \u05d1\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05e9\u05d7\u05e7\u05df"
    },
    "leadership_score": {
      "type": "number",
      "title": "\u05e6\u05d9\u05d5\u05df \u05de\u05e0\u05d4\u05d9\u05d2\u05d5\u05ea \u05e9\u05d8\u05d7 (1-5)",
      "description": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e9\u05d0\u05d9\u05e8 \u05e8\u05d9\u05e7 \u05d0\u05dd \u05dc\u05d0 \u05e0\u05e6\u05e4\u05ea\u05d4 \u05de\u05e0\u05d4\u05d9\u05d2\u05d5\u05ea \u05d1\u05d0\u05d9\u05de\u05d5\u05df \u05d6\u05d4"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea / \u05e2\u05d9\u05d1\u05d5\u05d3 \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9"
    }
  },
  "required": [
    "session_id",
    "player_id"
  ]
}