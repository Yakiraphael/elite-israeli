{
  "name": "Team",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
    "club_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05e9\u05d0\u05dc\u05d9\u05d5 \u05de\u05e9\u05d5\u05d9\u05db\u05ea \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4)"
    },
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4",
      "description": "\u05dc\u05de\u05e9\u05dc: \u05e0\u05e2\u05e8\u05d9\u05dd \u05d0', \u05d8\u05e8\u05d5\u05dd-\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u2014 \u05db\u05e4\u05d9 \u05e9\u05d9\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05e1\u05da \u05d1\u05d7\u05d9\u05e8\u05ea \u05d4\u05e7\u05d5\u05e0\u05d8\u05e7\u05e1\u05d8 \u05e9\u05dc \u05d4\u05de\u05d0\u05de\u05df"
    },
    "age_group": {
      "type": "string",
      "title": "\u05e7\u05d1\u05d5\u05e6\u05ea \u05d2\u05d9\u05dc",
      "description": "\u05dc\u05de\u05e9\u05dc: \u05e0\u05e2\u05e8\u05d9\u05dd \u05d0'"
    },
    "region": {
      "type": "string",
      "title": "\u05d0\u05d6\u05d5\u05e8 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea",
      "enum": [
        "\u05e0\u05ea\u05d9\u05d1\u05d5\u05ea",
        "\u05e7\u05e8\u05d9\u05d9\u05ea \u05d2\u05ea",
        "\u05d1\u05d0\u05e8 \u05e9\u05d1\u05e2",
        "\u05d0\u05d7\u05e8"
      ],
      "default": "\u05d0\u05d7\u05e8"
    },
    "sport": {
      "type": "string",
      "title": "\u05e2\u05e0\u05e3 \u05e1\u05e4\u05d5\u05e8\u05d8",
      "enum": [
        "\u05db\u05d3\u05d5\u05e8\u05d2\u05dc",
        "\u05e7\u05d8\u05e8\u05d2\u05dc"
      ],
      "default": "\u05db\u05d3\u05d5\u05e8\u05d2\u05dc"
    },
    "season_label": {
      "type": "string",
      "title": "\u05e2\u05d5\u05e0\u05d4",
      "default": "2026/27"
    },
    "coach_ids": {
      "type": "array",
      "title": "\u05de\u05d0\u05de\u05e0\u05d9\u05dd \u05de\u05d5\u05e8\u05e9\u05d9\u05dd",
      "items": {
        "type": "string"
      }
    },
    "roster": {
      "type": "array",
      "title": "\u05e1\u05d2\u05dc \u05d4\u05e9\u05d7\u05e7\u05e0\u05d9\u05dd",
      "items": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "title": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d7\u05e7\u05df"
          },
          "position": {
            "type": "string",
            "title": "\u05e2\u05de\u05d3\u05d4"
          },
          "shirt_number": {
            "type": "number",
            "title": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05d5\u05dc\u05e6\u05d4"
          },
          "status": {
            "type": "string",
            "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1\u05e1\u05d2\u05dc",
            "enum": [
              "active",
              "injured",
              "on_loan",
              "suspended"
            ],
            "default": "active"
          }
        }
      }
    }
  },
  "required": [
    "club_id",
    "name",
    "age_group"
  ]
}