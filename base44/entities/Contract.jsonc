{
  "name": "Contract",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d7\u05e7\u05df"
    },
    "player_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e9\u05d7\u05e7\u05df"
    },
    "contract_type": {
      "type": "string",
      "title": "\u05e1\u05d5\u05d2 \u05d7\u05d5\u05d6\u05d4",
      "enum": [
        "\u05d7\u05d5\u05d6\u05d4 \u05e0\u05d5\u05e2\u05e8",
        "\u05d7\u05d5\u05d6\u05d4 \u05d7\u05d5\u05d1\u05d1\u05e0\u05d9",
        "\u05d7\u05d5\u05d6\u05d4 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9",
        "\u05d7\u05d5\u05d6\u05d4 \u05de\u05d0\u05de\u05df"
      ],
      "default": "\u05d7\u05d5\u05d6\u05d4 \u05e0\u05d5\u05e2\u05e8"
    },
    "ifa_template_key": {
      "type": "string",
      "title": "\u05de\u05e4\u05ea\u05d7 \u05d8\u05d5\u05e4\u05e1 \u05e8\u05e9\u05de\u05d9 (IFA)",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d8\u05d5\u05e4\u05e1 \u05de\u05ea\u05d5\u05da \u05e1\u05e4\u05e8\u05d9\u05d9\u05ea ifaOfficialForms.js \u2014 \u05dc\u05de\u05e9\u05dc player_agreement_he, protocol_youth_company \u05d5\u05db\u05d5'."
    },
    "ifa_form_reference": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d8\u05d5\u05e4\u05e1 \u05d4\u05e8\u05e9\u05de\u05d9"
    },
    "filled_fields": {
      "type": "string",
      "title": "\u05e9\u05d3\u05d5\u05ea \u05de\u05de\u05d5\u05dc\u05d0\u05d9\u05dd (JSON)",
      "description": "JSON \u05de\u05d7\u05e8\u05d5\u05d6\u05ea \u05e9\u05dc \u05db\u05dc \u05d4\u05e9\u05d3\u05d5\u05ea \u05e9\u05de\u05d9\u05dc\u05d0 \u05d4\u05de\u05e0\u05d4\u05dc \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9 (\u05e9\u05db\u05e8, \u05ea\u05d0\u05e8\u05d9\u05db\u05d9\u05dd, \u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05de\u05e9\u05dc\u05d9\u05de\u05d5\u05ea, \u05e4\u05e8\u05d8\u05d9 \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d5\u05db\u05d5')."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d7\u05d9\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "document_url": {
      "type": "string",
      "title": "\u05e7\u05d5\u05d1\u05e5 \u05d7\u05d5\u05d6\u05d4 (PDF)"
    },
    "document_content": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05df \u05d7\u05d5\u05d6\u05d4 \u05d3\u05d9\u05d2\u05d9\u05d8\u05dc\u05d9 \u05e0\u05d9\u05ea\u05df \u05dc\u05d7\u05ea\u05d9\u05de\u05d4"
    },
    "salary_monthly": {
      "type": "number",
      "title": "\u05e9\u05db\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9 (\u20aa)"
    },
    "club_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05d4\u05d7\u05ea\u05d5\u05dd"
    },
    "status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "enum": [
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d7\u05ea\u05d9\u05de\u05d4",
        "\u05d7\u05ea\u05d5\u05dd",
        "\u05e4\u05d2 \u05ea\u05d5\u05e7\u05e3",
        "\u05d1\u05d5\u05d8\u05dc"
      ],
      "default": "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d7\u05ea\u05d9\u05de\u05d4"
    },
    "requires_guardian": {
      "type": "boolean",
      "title": "\u05e0\u05d3\u05e8\u05e9\u05ea \u05d7\u05ea\u05d9\u05de\u05ea \u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1",
      "default": false
    },
    "player_signature_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d7\u05d5\u05ea\u05dd \u05d4\u05e9\u05d7\u05e7\u05df"
    },
    "player_signed_at": {
      "type": "string",
      "title": "\u05de\u05d5\u05e2\u05d3 \u05d7\u05ea\u05d9\u05de\u05ea \u05d4\u05e9\u05d7\u05e7\u05df"
    },
    "player_signed_ip": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea IP \u2014 \u05d7\u05ea\u05d9\u05de\u05ea \u05e9\u05d7\u05e7\u05df"
    },
    "guardian_signature_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d7\u05d5\u05ea\u05dd \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1"
    },
    "guardian_signed_at": {
      "type": "string",
      "title": "\u05de\u05d5\u05e2\u05d3 \u05d7\u05ea\u05d9\u05de\u05ea \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1"
    },
    "guardian_signed_ip": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea IP \u2014 \u05d7\u05ea\u05d9\u05de\u05ea \u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1"
    },
    "signed_at": {
      "type": "string",
      "title": "\u05de\u05d5\u05e2\u05d3 \u05d7\u05ea\u05d9\u05de\u05d4 \u05e1\u05d5\u05e4\u05d9 (Timestamp)"
    },
    "signer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d7\u05d5\u05ea\u05dd (\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "signer_ip": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea IP \u05e9\u05dc \u05d4\u05d7\u05d5\u05ea\u05dd (\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8)"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "player_id",
    "player_name",
    "contract_type",
    "end_date"
  ]
}