{
  "name": "TeamReport",
  "type": "object",
  "properties": {
    "report_type": {
      "type": "string",
      "title": "\u05e1\u05d5\u05d2 \u05d3\u05d5\u05d7 \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9",
      "enum": [
        "\u05de\u05e7\u05e6\u05d5\u05e2\u05d9",
        "\u05de\u05e0\u05d8\u05dc\u05d9",
        "\u05d0\u05d9\u05e9\u05d9"
      ],
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2\u05d9 = \u05d3\u05d5\u05d7 \u05d8\u05e7\u05d8\u05d9\u05be\u05d8\u05db\u05e0\u05d9 \u05e9\u05dc \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u00b7 \u05de\u05e0\u05d8\u05dc\u05d9 = \u05d3\u05d5\u05d7 \u05de\u05e6\u05d1 \u05e0\u05e4\u05e9/\u05de\u05e0\u05d4\u05d9\u05d2\u05d5\u05ea/\u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u00b7 \u05d0\u05d9\u05e9\u05d9 = \u05d3\u05d5\u05d7 \u05d0\u05d9\u05e9\u05d9 \u05de\u05de\u05d5\u05e7\u05d3 \u05e9\u05d7\u05e7\u05df/\u05d9\u05ea"
    },
    "team_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "team_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "session_id": {
      "type": "string",
      "title": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d0\u05d9\u05de\u05d5\u05ea/\u05e1\u05d3\u05e0\u05d4 (TeamEvent.id)",
      "description": "\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 \u2014 \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e4\u05ea\u05d5\u05d7 \u05d3\u05d5\u05d7 \u05de\u05ea\u05d5\u05da \u05d0\u05d9\u05de\u05d5\u05ea \u05de\u05d4\u05e9\u05d8\u05d7 \u05d5\u05dc\u05d4\u05ea\u05e2\u05de\u05e7 \u05d1\u05d5 \u05de\u05ea\u05d5\u05da \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d0\u05d9\u05de\u05d5\u05e0\u05d9\u05dd"
    },
    "session_label": {
      "type": "string",
      "title": "\u05ea\u05d5\u05d5\u05d9\u05ea \u05d0\u05d9\u05de\u05d5\u05ea"
