{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor_id": {
      "type": "string",
      "title": "\u05de\u05d9 \u05e6\u05e4\u05d4 (User.id)"
    },
    "actor_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d1\u05e6\u05e2"
    },
    "actor_role": {
      "type": "string",
      "title": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05de\u05d1\u05e6\u05e2"
    },
    "action": {
      "type": "string",
      "title": "\u05e4\u05e2\u05d5\u05dc\u05d4",
      "enum": [
        "view_medical",
        "view_contract",
        "delete_player",
        "export_data",
        "unauthorized_attempt",
        "sign_player",
        "status_change",
        "consent_signed",
        "retention_anonymize",
        "retention_delete"
      ]
    },
    "player_id": {
      "type": "string",
      "title": "\u05e9\u05d7\u05e7\u05df \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9"
    },
    "club_id": {
      "type": "string",
      "title": "\u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
    "details": {
      "type": "string",
      "title": "\u05e4\u05e8\u05d8\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd"
    },
    "terms_version": {
      "type": "string",
      "title": "\u05d2\u05e8\u05e1\u05ea \u05ea\u05e7\u05e0\u05d5\u05df \u05d1\u05ea\u05d5\u05e7\u05e3 \u05d1\u05e2\u05ea \u05d4\u05d7\u05ea\u05d9\u05de\u05d4 (Versioning)",
      "description": "\u05ea\u05d9\u05e2\u05d5\u05d3 \u05d2\u05e8\u05e1\u05ea \u05d4\u05ea\u05e7\u05e0\u05d5\u05df \u05d4\u05e8\u05d2\u05d5\u05dc\u05d8\u05d5\u05e8\u05d9 \u05e9\u05d4\u05d9\u05d4 \u05d1\u05ea\u05d5\u05e7\u05e3 \u05d1\u05e8\u05d2\u05e2 \u05d4\u05d7\u05ea\u05d9\u05de\u05d4 / \u05d4\u05d4\u05e1\u05db\u05de\u05d4. \u05de\u05d0\u05e4\u05e9\u05e8 \u05e9\u05d7\u05d6\u05d5\u05e8 \u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc \u05d4\u05ea\u05e0\u05d0\u05d9\u05dd \u05e9\u05d0\u05d9\u05e9\u05e8 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d2\u05dd \u05d0\u05dd \u05d4\u05ea\u05e7\u05e0\u05d5\u05df \u05d4\u05ea\u05e2\u05d3\u05db\u05df \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df."
    },
    "consent_fields": {
      "type": "array",
      "title": "\u05e1\u05e2\u05d9\u05e4\u05d9 \u05d4\u05e1\u05db\u05de\u05d4 \u05e9\u05d0\u05d5\u05e9\u05e8\u05d5",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d6\u05d4\u05d9 \u05e1\u05e2\u05d9\u05e4\u05d9\u05dd (platform_terms, media_consent \u05d5\u05db\u05d5') \u05e9\u05d0\u05d5\u05e9\u05e8\u05d5 \u05d1\u05e2\u05ea \u05d4\u05d7\u05ea\u05d9\u05de\u05d4 \u2014 \u05dc\u05ea\u05d9\u05e2\u05d5\u05d3 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05d9\u05e7\u05e3 \u05d4\u05d4\u05e1\u05db\u05de\u05d4."
    },
    "actor_ip": {
      "type": "string",
      "title": "\u05db\u05ea\u05d5\u05d1\u05ea IP \u05d1\u05e2\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4",
      "description": "\u05e0\u05e8\u05e9\u05de\u05ea \u05d1\u05d6\u05e8\u05d9\u05de\u05d5\u05ea \u05d7\u05ea\u05d9\u05de\u05d4 \u05e6\u05d3-\u05e9\u05e8\u05ea (signContract) \u05dc\u05d0\u05db\u05d9\u05e4\u05ea Non-repudiation. \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d9\u05e9\u05d0\u05e8 \u05e8\u05d9\u05e7\u05d4 \u05d1\u05d7\u05ea\u05d9\u05de\u05d5\u05ea \u05e6\u05d3-\u05dc\u05e7\u05d5\u05d7."
    }
  },
  "required": [
    "actor_id",
    "action"
  ]
}