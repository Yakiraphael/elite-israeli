{
  "name": "PlayerComplianceDoc",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05d3\u05d5\u05df (Club.id)",
      "description": "\u05d1\u05d9\u05d3\u05d5\u05d3 \u05e8\u05d1-\u05de\u05d5\u05e2\u05d3\u05d5\u05e0\u05d9 \u2014 \u05de\u05e1\u05de\u05db\u05d9 \u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05e9\u05d9\u05d9\u05db\u05d9\u05dd \u05dc\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05d1\u05d5 \u05d4\u05e9\u05d7\u05e7\u05df \u05e8\u05e9\u05d5\u05dd. RLS \u05d7\u05d5\u05e1\u05dd \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d7\u05d5\u05e6\u05ea-\u05de\u05d5\u05e2\u05d3\u05d5\u05e0\u05d9\u05dd."
    },
    "player_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d7\u05e7\u05df (PlayerRegistration.id)"
    },
    "player_name": {
      "type": "string"
    },
    "doc_type": {
      "type": "string",
      "title": "\u05e1\u05d5\u05d2 \u05de\u05e1\u05de\u05da",
      "enum": [
        "MEDICAL_CERTIFICATE",
        "PARENTAL_CONSENT",
        "IFA_REGISTRATION_FORM",
        "MEDIA_CONSENT",
        "POWER_OF_ATTORNEY"
      ],
      "description": "MEDICAL_CERTIFICATE = \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05dc\u05db\u05e9\u05d9\u05e8\u05d5\u05ea, PARENTAL_CONSENT = \u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05d5\u05e8\u05d4/\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1, IFA_REGISTRATION_FORM = \u05d8\u05d5\u05e4\u05e1 \u05e8\u05d9\u05e9\u05d5\u05dd \u05d4\u05ea\u05d0\u05d7\u05d3\u05d5\u05ea, MEDIA_CONSENT = \u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05d3\u05d9\u05d4, POWER_OF_ATTORNEY = \u05d9\u05d9\u05e4\u05d5\u05d9 \u05db\u05d5\u05d7."
    },
    "file_url": {
      "type": "string",
      "title": "\u05e7\u05d5\u05d1\u05e5 \u05de\u05e1\u05de\u05da"
    },
    "is_verified": {
      "type": "boolean",
      "title": "\u05de\u05d0\u05d5\u05de\u05ea",
      "default": false
    },
    "verified_by_name": {
      "type": "string",
      "title": "\u05d0\u05d5\u05de\u05ea \u05e2\u05f4\u05d9"
    },
    "verified_at": {
      "type": "string",
      "title": "\u05de\u05d5\u05e2\u05d3 \u05d0\u05d9\u05de\u05d5\u05ea"
    },
    "uploaded_by_name": {
      "type": "string",
      "title": "\u05d4\u05d5\u05e2\u05dc\u05d4 \u05e2\u05f4\u05d9"
    },
    "notes": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string",
      "title": "\u05e1\u05d9\u05d1\u05ea \u05d3\u05d7\u05d9\u05d9\u05d4"
    }
  },
  "required": [
    "club_id",
    "player_id",
    "doc_type",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}