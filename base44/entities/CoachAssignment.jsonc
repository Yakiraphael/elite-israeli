    },
    "coach_email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d0\u05de\u05df"
    },
    "coach_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d0\u05de\u05df"
    },
    "team_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e7\u05d1\u05d5\u05e6\u05d4 (Team.id)"
    },
    "team_label": {
      "type": "string",
      "title": "\u05ea\u05d5\u05d5\u05d9\u05ea \u05e7\u05d1\u05d5\u05e6\u05d4 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4",
      "description": "\u05dc\u05de\u05e9\u05dc: \u05e0\u05e2\u05e8\u05d9\u05dd \u05d0' \u00b7 \u05db\u05d3\u05d5\u05e8\u05d2\u05dc (\u05e0\u05ea\u05d9\u05d1\u05d5\u05ea)"
    },
    "club_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
    "club_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
