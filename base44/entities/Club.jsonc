{
  "name": "Club",
  "type": "object",
  "properties": {
    "club_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
    "admin_ids": {
      "type": "array",
      "title": "\u05de\u05e0\u05d4\u05dc\u05d9\u05dd \u05de\u05d5\u05e8\u05e9\u05d9\u05dd",
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea UIDs \u05e9\u05dc \u05de\u05e0\u05d4\u05dc\u05d9 \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "object",
      "title": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05de\u05d5\u05e2\u05d3\u05d5\u05df",
      "properties": {
        "logo_url": {
          "type": "string",
          "title": "\u05dc\u05d5\u05d2\u05d5"
        },
        "primary_color": {
          "type": "string",
          "title": "\u05e6\u05d1\u05e2 \u05e8\u05d0\u05e9\u05d9"
        },
        "season_label": {
          "type": "string",
          "title": "\u05e2\u05d5\u05e0\u05d4 \u05e0\u05d5\u05db\u05d7\u05d9\u05ea"
        }
      }
    },
    "organization_type": {
      "type": "string",
      "title": "\u05e1\u05d5\u05d2 \u05d2\u05d5\u05e3 \u05de\u05e9\u05e4\u05d8\u05d9",
      "enum": [
        "\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05e8\u05e9\u05d5\u05dd (\u05d7\u05d1\u05e8\u05d4 / \u05e2\u05de\u05d5\u05ea\u05d4)",
        "\u05e2\u05de\u05d5\u05ea\u05d4 / \u05d0\u05d9\u05d2\u05d5\u05d3 \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05dc\u05d9\u05d2\u05d5\u05ea"
      ],
      "default": "\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05e8\u05e9\u05d5\u05dd (\u05d7\u05d1\u05e8\u05d4 / \u05e2\u05de\u05d5\u05ea\u05d4)",
      "description": "\u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05db\u05d3\u05d5\u05e8\u05d2\u05dc \u05e8\u05e9\u05d5\u05dd (\u05e2\u05dd \u05de\u05d2\u05e8\u05e9 \u05d5\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05de\u05e9\u05dc\u05d5) \u05dc\u05d1\u05d9\u05df \u05e2\u05de\u05d5\u05ea\u05d4/\u05d0\u05d9\u05d2\u05d5\u05d3 \u05d4\u05de\u05e4\u05e2\u05d9\u05dc \u05dc\u05d9\u05d2\u05d5\u05ea \u05e0\u05d5\u05e2\u05e8/\u05d9\u05dc\u05d3\u05d9\u05dd/\u05d7\u05d5\u05d1\u05d1\u05e0\u05d9\u05d5\u05ea."
    },
    "org_classification": {
      "type": "string",
      "title": "\u05e1\u05d9\u05d5\u05d5\u05d2 \u05d0\u05e8\u05d2\u05d5\u05e0\u05d9 (Org Classification)",
      "enum": [
        "IFA_VERIFIED",
        "YOUTH_DEPARTMENT",
        "AMATEUR_LEAGUE",
        "ASSOCIATION"
      ],
      "default": "YOUTH_DEPARTMENT",
      "description": "\u05e7\u05d5\u05d1\u05e2 \u05d0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05e9\u05d7\u05e7\u05df \u05d5\u05d0\u05ea \u05de\u05e0\u05d5\u05e2 \u05d4\u05e1\u05e7\u05d0\u05d5\u05d8\u05d9\u05e0\u05d2 \u05d4\u05de\u05d5\u05e6\u05d2\u05d9\u05dd. IFA_VERIFIED = \u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05de\u05d0\u05d5\u05de\u05ea \u05d4\u05ea\u05d0\u05d7\u05d3\u05d5\u05ea (\u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05e8\u05e9\u05de\u05d9\u05d5\u05ea, \u05d3\u05de\u05d9 \u05d4\u05e9\u05d1\u05d7\u05d4, \u05de\u05e2\u05e7\u05d1 \u05d7\u05d5\u05d6\u05d9\u05dd). AMATEUR_LEAGUE/ASSOCIATION = \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d8\u05d5\u05e8\u05e0\u05d9\u05e8 \u05d5\u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea. YOUTH_DEPARTMENT = \u05e1\u05e7\u05d0\u05d5\u05d8\u05d9\u05e0\u05d2 \u05e4\u05e0\u05d9\u05de\u05d9 \u05d2\u05de\u05d9\u05e9."
    },
    "club_tier": {
      "type": "string",
      "title": "\u05d3\u05e8\u05d2 \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df",
      "enum": [
        "Tier 1 \u2014 \u05e2\u05dc\u05d9\u05ea (\u05dc\u05d9\u05d2\u05ea \u05d4\u05e2\u05dc / \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9)",
        "Tier 2 \u2014 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05dc\u05d0\u05d5\u05de\u05d9\u05ea",
        "Tier 3 \u2014 \u05d7\u05d5\u05d1\u05d1\u05df \u05e8\u05e9\u05d5\u05dd A (\u05dc\u05d9\u05d2\u05d4 \u05d0/\u05d1, \u05de\u05d2\u05e8\u05e9 \u05d1\u05d1\u05e2\u05dc\u05d5\u05ea)",
        "Tier 4 \u2014 \u05d7\u05d5\u05d1\u05d1\u05df \u05e8\u05e9\u05d5\u05dd B (\u05dc\u05d9\u05d2\u05d5\u05ea \u05de\u05d7\u05d5\u05d6\u05d9\u05d5\u05ea/\u05d0\u05d6\u05d5\u05e8\u05d9\u05d5\u05ea)",
        "Tier 5 \u2014 \u05e2\u05de\u05d5\u05ea\u05d4 / \u05d0\u05d9\u05d2\u05d5\u05d3 \u05e0\u05d5\u05e2\u05e8 \u05d5\u05d9\u05dc\u05d3\u05d9\u05dd (\u05dc\u05d0 \u05e2\u05dc \u05d3\u05e9\u05d0)"
      ],
      "default": "Tier 5 \u2014 \u05e2\u05de\u05d5\u05ea\u05d4 / \u05d0\u05d9\u05d2\u05d5\u05d3 \u05e0\u05d5\u05e2\u05e8 \u05d5\u05d9\u05dc\u05d3\u05d9\u05dd (\u05dc\u05d0 \u05e2\u05dc \u05d3\u05e9\u05d0)"
    },
    "subscription_plan": {
      "type": "string",
      "title": "\u05d7\u05d1\u05d9\u05dc\u05ea \u05de\u05e0\u05d5\u05d9",
      "enum": [
        "FREE",
        "PRO",
        "ENTERPRISE"
      ],
      "default": "FREE"
    },
    "max_allowed_users": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 (Seats)",
      "description": "1 = FREE, 5 = PRO, 999 = ENTERPRISE (\u05dc\u05dc\u05d0 \u05d4\u05d2\u05d1\u05dc\u05d4)"
    },
    "subscription_status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e0\u05d5\u05d9",
      "enum": [
        "FREE",
        "PRO",
        "ENTERPRISE",
        "TRIAL"
      ],
      "default": "FREE"
    },
    "contact_name": {
      "type": "string",
      "title": "\u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05e8\u05d0\u05e9\u05d9"
    },
    "contact_email": {
      "type": "string",
      "title": "\u05de\u05d9\u05d9\u05dc \u05e8\u05e9\u05de\u05d9 \u05e9\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
    "contact_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d0\u05d9\u05e9 \u05e7\u05e9\u05e8"
    },
    "is_verified": {
      "type": "boolean",
      "title": "\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05de\u05d0\u05d5\u05de\u05ea",
      "default": false,
      "description": "\u05d0\u05d9\u05de\u05d5\u05ea \u05d9\u05d3\u05e0\u05d9 \u05e9\u05dc \u05d4\u05de\u05d9\u05d9\u05dc \u05d4\u05e8\u05e9\u05de\u05d9 \u05d5\u05d6\u05d4\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df"
    },
    "city": {
      "type": "string",
      "title": "\u05e2\u05d9\u05e8"
    },
    "business_id": {
      "type": "string",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05d7\"\u05e4 / \u05e2\u05de\u05d5\u05ea\u05d4"
    },
    "league_name": {
      "type": "string",
      "title": "\u05dc\u05d9\u05d2\u05d4 / \u05d0\u05d9\u05d2\u05d5\u05d3 \u05e8\u05e9\u05d5\u05dd"
    },
    "verification_status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d0\u05d9\u05de\u05d5\u05ea \u05de\u05d5\u05e2\u05d3\u05d5\u05df",
      "enum": [
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05de\u05d5\u05ea",
        "\u05de\u05d0\u05d5\u05de\u05ea",
        "\u05e0\u05d3\u05d7\u05d4"
      ],
      "default": "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05de\u05d5\u05ea"
    },
    "operational_status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e4\u05e2\u05d5\u05dc\u05d9",
      "enum": [
        "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d4\u05e4\u05e2\u05dc\u05d4",
        "\u05d1\u05d1\u05d3\u05d9\u05e7\u05d4",
        "\u05e4\u05e2\u05d9\u05dc",
        "\u05de\u05d5\u05e9\u05e2\u05d4",
        "\u05e0\u05d3\u05d7\u05d4"
      ],
      "default": "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d4\u05e4\u05e2\u05dc\u05d4",
      "description": "\u05e9\u05dc\u05d1\u05d9 \u05e7\u05dc\u05d9\u05d8\u05d4: \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d4\u05e4\u05e2\u05dc\u05d4 \u2192 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u2192 \u05e4\u05e2\u05d9\u05dc. \u05de\u05e0\u05d4\u05dc \u05e2\u05dc \u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e9\u05e2\u05d9\u05d4/\u05d3\u05d7\u05d9\u05d9\u05d4."
    },
    "onboarding_stage": {
      "type": "string",
      "title": "\u05e9\u05dc\u05d1 \u05e7\u05dc\u05d9\u05d8\u05d4",
      "enum": [
        "\u05d4\u05d2\u05e9\u05d4",
        "\u05d0\u05d9\u05de\u05d5\u05ea \u05de\u05e1\u05de\u05db\u05d9\u05dd",
        "\u05d7\u05d1\u05e8\u05d5\u05ea \u05d1\u05d4\u05ea\u05d0\u05d7\u05d3\u05d5\u05ea",
        "\u05e4\u05e2\u05d9\u05dc"
      ],
      "default": "\u05d4\u05d2\u05e9\u05d4",
      "description": "\u05ea\u05d9\u05e2\u05d5\u05d3 \u05e9\u05dc\u05d1-\u05d0\u05d7\u05e8-\u05e9\u05dc\u05d1 \u05d1\u05e6\u05d9\u05e8 \u05d4\u05e7\u05dc\u05d9\u05d8\u05d4 \u05de\u05d5\u05dc \u05d4-Super Admin."
    },
    "incorporation_certificate_url": {
      "type": "string",
      "title": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05e8\u05d9\u05e9\u05d5\u05dd \u05de\u05d8\u05e2\u05dd \u05e8\u05e9\u05dd \u05d4\u05d7\u05d1\u05e8\u05d5\u05ea / \u05e8\u05e9\u05dd \u05d4\u05e2\u05de\u05d5\u05ea\u05d5\u05ea",
      "description": "\u05e6\u05d9\u05dc\u05d5\u05dd \u05ea\u05e2\u05d5\u05d3\u05ea \u05e8\u05d9\u05e9\u05d5\u05dd \u05e8\u05e9\u05de\u05d9\u05ea (\u05e0\u05d9\u05d9\u05e8 \u05d4\u05e7\u05de\u05d4 / \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e2\u05de\u05d5\u05ea\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4) \u2014 \u05d7\u05d5\u05d1\u05d4 \u05dc\u05d0\u05d9\u05de\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05de\u05d5\u05dc \u05d4\u05d4\u05ea\u05d0\u05d7\u05d3\u05d5\u05ea."
    },
    "ifa_membership_certificate_url": {
      "type": "string",
      "title": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d7\u05d1\u05e8\u05d5\u05ea \u05d1\u05d4\u05ea\u05d0\u05d7\u05d3\u05d5\u05ea \u05dc\u05db\u05d3\u05d5\u05e8\u05d2\u05dc \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc",
      "description": "\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d7\u05d1\u05e8\u05d5\u05ea \u05e2\u05d3\u05db\u05e0\u05d9 \u05d1\u05d4\u05ea\u05d0\u05d7\u05d3\u05d5\u05ea \u05dc\u05db\u05d3\u05d5\u05e8\u05d2\u05dc \u2014 \u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d9\u05de\u05d5\u05ea \u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df \u05d1\u05dc\u05d9\u05d2\u05d5\u05ea \u05e8\u05e9\u05de\u05d9\u05d5\u05ea."
    },
    "insurance_certificate_url": {
      "type": "string",
      "title": "\u05e4\u05d5\u05dc\u05d9\u05e1\u05ea \u05d1\u05d9\u05d8\u05d5\u05d7 \u05d7\u05d1\u05d5\u05ea \u05de\u05e2\u05d1\u05d9\u05d3 / \u05e6\u05d3 \u05d2' \u05e4\u05e2\u05d9\u05dc\u05d4",
      "description": "\u05e4\u05d5\u05dc\u05d9\u05e1\u05ea \u05d1\u05d9\u05d8\u05d5\u05d7 \u05e9\u05d5\u05d8\u05e4\u05ea \u2014 \u05ea\u05e0\u05d0\u05d9 \u05dc\u05d4\u05e4\u05e2\u05dc\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e8\u05e9\u05de\u05d9\u05ea."
    },
    "protocol_documents": {
      "type": "array",
      "title": "\u05de\u05e1\u05de\u05db\u05d9\u05dd \u05de\u05d5\u05e1\u05d3\u05d9\u05d9\u05dd (\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc\u05d9\u05dd, \u05d0\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd, \u05ea\u05e7\u05e0\u05d5\u05e0\u05d9\u05dd)",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "\u05e9\u05dd \u05d4\u05de\u05e1\u05de\u05da"
          },
          "doc_type": {
            "type": "string",
            "title": "\u05e1\u05d5\u05d2",
            "enum": [
              "\u05ea\u05e7\u05e0\u05d5\u05df",
              "\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc",
              "\u05d0\u05d9\u05e9\u05d5\u05e8",
              "\u05d0\u05d7\u05e8"
            ]
          },
          "file_url": {
            "type": "string",
            "title": "\u05e7\u05d5\u05d1\u05e5\u05e5"
          },
          "uploaded_at": {
            "type": "string",
            "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e2\u05dc\u05d0\u05d4"
          }
        }
      }
    },
    "rejection_reason": {
      "type": "string",
      "title": "\u05e1\u05d9\u05d1\u05ea \u05d3\u05d7\u05d9\u05d9\u05d4 / \u05d4\u05e9\u05d4\u05d9\u05d4"
    },
    "reviewer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05d5\u05d7\u05df (User.id)"
    },
    "reviewer_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d1\u05d5\u05d7\u05df"
    },
    "reviewed_at": {
      "type": "string",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d1\u05d7\u05d9\u05e0\u05d4 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "operational_active_from": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d7\u05d9\u05dc\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05d5\u05d8\u05e4\u05ea"
    }
  },
  "required": [
    "club_name",
    "club_tier"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.admin_ids": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
