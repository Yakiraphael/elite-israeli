{
  "name": "LeagueTeam",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05d3\u05d5\u05df / \u05d0\u05e8\u05d2\u05d5\u05df (Club.id)"
    },
    "club_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df / \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "team_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e7\u05d1\u05d5\u05e6\u05d4 \u05dc\u05d4\u05d2\u05e8\u05dc\u05d4",
      "description": "\u05d4\u05e9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05e9\u05d7\u05e7\u05d9\u05dd (\u05d1\u05d9\u05ea/\u05d7\u05d5\u05e5)"
    },
    "age_group": {
      "type": "string",
      "title": "\u05e9\u05e0\u05ea\u05d5\u05df",
      "description": "\u05dc\u05de\u05e9\u05dc: \u05e0\u05e2\u05e8\u05d9\u05dd \u05d0\u05f3, \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05f3"
    },
    "is_registered": {
      "type": "boolean",
      "default": true,
      "title": "\u05e8\u05e9\u05d5\u05de\u05d4 \u05dc\u05d4\u05d2\u05e8\u05dc\u05d4"
    },
    "seed_tier": {
      "type": "number",
      "title": "\u05d3\u05e8\u05d2 \u05d6\u05e8\u05d9\u05e2\u05d4 (TIER) \u05dc\u05de\u05e6\u05d1 TIERED",
      "description": "1 = \u05d2\u05d1\u05d5\u05d4. \u05de\u05e9\u05de\u05e9 \u05db\u05e9-seeding_mode = TIERED"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "club_id",
    "team_name",
    "age_group"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "coach"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}