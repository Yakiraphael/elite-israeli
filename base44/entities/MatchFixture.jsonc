{
  "name": "MatchFixture",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05d3\u05d5\u05df (Club.id)"
    },
    "club_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e2\u05d3\u05d5\u05df / \u05d4\u05dc\u05d9\u05d2\u05d4"
    },
    "competition": {
      "type": "string",
      "title": "\u05de\u05e1\u05d2\u05e8\u05ea / \u05dc\u05d9\u05d2\u05d4 / \u05d8\u05d5\u05e8\u05e0\u05d9\u05e8"
    },
    "competition_id": {
      "type": "string",
      "title": "\u05d4\u05d2\u05d3\u05e8\u05ea \u05ea\u05d7\u05e8\u05d5\u05ea (Competition.id)",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d9\u05e9\u05d5\u05ea Competition \u2014 \u05e4\u05d5\u05e8\u05de\u05d8, \u05db\u05de\u05d5\u05ea \u05e9\u05d7\u05e7\u05e0\u05d9\u05dd, \u05e1\u05d5\u05d2 \u05de\u05d2\u05e8\u05e9 \u05d5\u05e9\u05d9\u05d8\u05ea \u05e0\u05d9\u05e7\u05d5\u05d3. \u05de\u05d0\u05d5\u05e4\u05e1 \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05e9\u05d7\u05e7 \u05e0\u05d5\u05e6\u05e8 \u05de\u05ea\u05d5\u05da \u05ea\u05d7\u05e8\u05d5\u05ea \u05de\u05d5\u05d2\u05d3\u05e8\u05ea."
    },
    "round": {
      "type": "string",
      "title": "\u05de\u05d7\u05d6\u05d5\u05e8 / \u05e9\u05dc\u05d1"
    },
    "matchday": {
      "type": "number",
      "title": "\u05de\u05e1\u05e4\u05e8 \u05de\u05d7\u05d6\u05d5\u05e8 (Matchday)",
      "description": "\u05de\u05d9\u05e1\u05e4\u05d5\u05e8 \u05e8\u05e6\u05d9\u05e3 \u05de-1 \u05e9\u05e0\u05d5\u05e6\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05e0\u05d5\u05e2 \u05d4\u05d4\u05d2\u05e8\u05dc\u05d4"
    },
    "age_group": {
      "type": "string",
      "title": "\u05e9\u05e0\u05ea\u05d5\u05df / \u05e7\u05d1\u05d5\u05e6\u05ea \u05d2\u05d9\u05dc"
    },
    "home_team": {
      "type": "string",
      "title": "\u05e7\u05d1\u05d5\u05e6\u05ea \u05d1\u05d9\u05ea"
    },
    "away_team": {
      "type": "string",
      "title": "\u05e7\u05d1\u05d5\u05e6\u05ea \u05d7\u05d5\u05e5"
    },
    "match_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05e9\u05d7\u05e7",
      "description": "\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 \u2014 \u05de\u05e9\u05d7\u05e7\u05d9\u05dd \u05de\u05d5\u05d2\u05e8\u05dc\u05d9\u05dd \u05e0\u05d5\u05e6\u05e8\u05d9\u05dd \u05dc\u05dc\u05d0 \u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05d3 \u05ea\u05d9\u05d0\u05d5\u05dd \u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9"
    },
    "kickoff_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05e4\u05ea\u05d9\u05d7\u05d4 (HH:MM)"
    },
    "stadium_name": {
      "type": "string",
      "title": "\u05de\u05d2\u05e8\u05e9 / \u05d0\u05e6\u05d8\u05d3\u05d9\u05d5\u05df"
    },
    "home_score": {
      "type": "number",
      "title": "\u05ea\u05d5\u05e6\u05d0\u05d4 \u2014 \u05e9\u05e2\u05e8\u05d9 \u05d1\u05d9\u05ea (\u05de\u05d0\u05d5\u05de\u05ea)"
    },
    "away_score": {
      "type": "number",
      "title": "\u05ea\u05d5\u05e6\u05d0\u05d4 \u2014 \u05e9\u05e2\u05e8\u05d9 \u05d7\u05d5\u05e5 (\u05de\u05d0\u05d5\u05de\u05ea)"
    },
    "home_reported_score": {
      "type": "number",
      "title": "\u05d3\u05d9\u05d5\u05d5\u05d7 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05e6\u05d3 \u05d4\u05d1\u05d9\u05ea"
    },
    "away_reported_score": {
      "type": "number",
      "title": "\u05d3\u05d9\u05d5\u05d5\u05d7 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05e6\u05d3 \u05d4\u05d7\u05d5\u05e5"
    },
    "home_scorers": {
      "type": "array",
      "title": "\u05de\u05d1\u05e7\u05d9\u05e2\u05d9\u05dd \u2014 \u05e7\u05d1\u05d5\u05e6\u05ea \u05d1\u05d9\u05ea",
      "items": {
        "type": "string"
      }
    },
    "away_scorers": {
      "type": "array",
      "title": "\u05de\u05d1\u05e7\u05d9\u05e2\u05d9\u05dd \u2014 \u05e7\u05d1\u05d5\u05e6\u05ea \u05d7\u05d5\u05e5",
      "items": {
        "type": "string"
      }
    },
    "home_proposed_date": {
      "type": "string",
      "format": "date",
      "title": "\u05d4\u05e6\u05e2\u05ea \u05de\u05d5\u05e2\u05d3 \u05de\u05e6\u05d3 \u05d4\u05d1\u05d9\u05ea"
    },
    "home_proposed_time": {
      "type": "string",
      "title": "\u05d4\u05e6\u05e2\u05ea \u05e9\u05e2\u05d4 \u05de\u05e6\u05d3 \u05d4\u05d1\u05d9\u05ea"
    },
    "home_proposed_stadium": {
      "type": "string",
      "title": "\u05d4\u05e6\u05e2\u05ea \u05de\u05d2\u05e8\u05e9 \u05de\u05e6\u05d3 \u05d4\u05d1\u05d9\u05ea"
    },
    "coordination_status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05d9\u05d0\u05d5\u05dd",
      "default": "PENDING_COORDINATION",
      "enum": [
        "PENDING_COORDINATION",
        "HOME_APPROVED",
        "AWAY_APPROVED",
        "FULLY_COORDINATED",
        "AWAITING_FINAL_APPROVAL"
      ],
      "description": "PENDING_COORDINATION = \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05ea\u05d9\u05d0\u05d5\u05dd, HOME_APPROVED = \u05d4\u05d1\u05d9\u05ea \u05d4\u05e6\u05d9\u05e2 \u05de\u05d5\u05e2\u05d3, AWAY_APPROVED = \u05d4\u05d7\u05d5\u05e5 \u05d0\u05d9\u05e9\u05e8, FULLY_COORDINATED = \u05de\u05ea\u05d5\u05d0\u05dd \u05d5\u05de\u05d0\u05d5\u05e9\u05e8, AWAITING_FINAL_APPROVAL = \u05de\u05ea\u05d5\u05d0\u05dd \u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9 \u05d5\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05e0\u05d4\u05dc\u05ea \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "result_status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05d5\u05e6\u05d0\u05d4",
      "default": "PENDING_REPORT",
      "enum": [
        "PENDING_REPORT",
        "HOME_REPORTED",
        "AWAY_REPORTED",
        "VERIFIED_AND_APPROVED",
        "DISPUTED"
      ],
      "description": "\u05d0\u05d9\u05de\u05d5\u05ea \u05e6\u05d5\u05dc\u05d1 \u05e9\u05dc \u05d3\u05d9\u05d5\u05d5\u05d7\u05d9 \u05d1\u05d9\u05ea/\u05d7\u05d5\u05e5 \u2014 \u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05de\u05d0\u05e9\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea; \u05d0\u05d9-\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05e0\u05d5\u05e2\u05dc \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e0\u05d4\u05dc\u05ea \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "disputed_reason": {
      "type": "string",
      "title": "\u05e1\u05d9\u05d1\u05ea \u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05ea\u05d5\u05e6\u05d0\u05d4"
    },
    "referee_assigned_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e9\u05d5\u05e4\u05d8 \u05de\u05e9\u05d5\u05d1\u05e5 (User.id)"
    },
    "referee_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e9\u05d5\u05e4\u05d8"
    },
    "referee_status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d6\u05d9\u05de\u05d5\u05df \u05e9\u05d5\u05e4\u05d8",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "DECLINED",
        "NOT_REQUIRED"
      ],
      "default": "PENDING"
    },
    "referee_invited_at": {
      "type": "string",
      "title": "\u05de\u05d5\u05e2\u05d3 \u05e9\u05dc\u05d9\u05d7\u05ea \u05d6\u05d9\u05de\u05d5\u05df \u05e9\u05d5\u05e4\u05d8"
    },
    "status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e9\u05d7\u05e7",
      "enum": [
        "SCHEDULED",
        "POSTPONED",
        "CANCELLED",
        "COMPLETED"
      ],
      "default": "SCHEDULED"
    },
    "import_source": {
      "type": "string",
      "title": "\u05de\u05e7\u05d5\u05e8 \u05d9\u05d9\u05d1\u05d5\u05d0 / \u05d9\u05e6\u05d9\u05e8\u05d4"
    },
    "last_conflict_check": {
      "type": "string",
      "title": "\u05ea\u05d5\u05e6\u05d0\u05ea \u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05ea\u05e0\u05d2\u05e9\u05d5\u05d9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 (JSON)"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "club_id",
    "age_group",
    "home_team",
    "away_team"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.club_id": "{{user.data.club_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "coach"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "coach"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.club_id": "{{user.data.club_id}}"
            },
            {
              "user_condition": {
                "role": "director"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}